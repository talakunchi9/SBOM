# -----------------------------------------------------------------------------
# BOM Engine — example environment configuration
# Copy to .env for local development.
# All operational values are configuration-driven (see spec §55).
# -----------------------------------------------------------------------------

# HTTP API
API_ADDR=:8080
API_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# Persistence. PostgreSQL is required.
DATABASE_URL=postgresql://sbom:123456789@127.0.0.1:5432/S-BOM

# Object storage for uploaded archives, extracted workspaces and generated
# export artifacts. `local://` uses a directory on disk. `s3://` is prepared
# via the same interface but requires the S3 driver to be wired.
OBJECT_STORAGE_URL=local://./data/objects

# Secret / credential store (see spec §13). Options: `env` (dev only, KEK from
# env), `vault` (HashiCorp Vault), `aws-sm`, `azure-kv`, `gcp-sm`.
CREDENTIAL_STORE=env
# 32-byte base64 key used to encrypt credential material at rest when store=env.
# NEVER reuse this key in production. Generate with: openssl rand -base64 32
CREDENTIAL_KEK=REPLACE_ME_WITH_32_BYTES_BASE64_ENCODED_KEY==

# Job queue. `db` uses the same database as a durable queue (SELECT ... FOR UPDATE
# SKIP LOCKED). `inmem` is only appropriate for tests. `kafka`/`redis` are stubs.
QUEUE_DRIVER=db
QUEUE_POLL_INTERVAL_MS=500

# Worker pool
SCANNER_WORKERS=4
SCAN_TIMEOUT_SECONDS=1800
MAX_CONCURRENT_SCANS=16

# Scanner limits (§8, §41, §43)
MAX_UPLOAD_SIZE_BYTES=1073741824          # 1 GiB
MAX_ARCHIVE_UNCOMPRESSED_BYTES=1073741824 # 1 GiB
MAX_FILES_PER_ARCHIVE=50000
MAX_ARCHIVE_ENTRY_BYTES=1073741824        # 1 GiB per entry
ARCHIVE_MAX_COMPRESSION_RATIO=100         # zip-bomb guard

# GitHub
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT_SECONDS=30
GITHUB_WEBHOOK_SECRET=REPLACE_ME
# When set, the backend can act as a GitHub App. The private key is loaded from
# GITHUB_APP_PRIVATE_KEY (PEM contents) or GITHUB_APP_PRIVATE_KEY_FILE.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_FILE=./secrets/github-app.pem

# Vulnerability provider. `mitre` fetches each CVE from the MITRE CVE Services
# API (GET https://cveawg.mitre.org/api/cve/{id}). Package-to-CVE-ID hints come
# from OSV because the public MITRE API has no package search.
# `osv` skips the MITRE record fetch.
VULN_PROVIDER=mitre
MITRE_CVE_API_URL=https://cveawg.mitre.org/api
VULN_PROVIDER_TIMEOUT_SECONDS=20

# Bulk limits (§43)
MAX_BULK_ROWS=5000
MAX_BULK_FILE_BYTES=52428800              # 50 MiB

# Observability
LOG_LEVEL=info
LOG_FORMAT=json
